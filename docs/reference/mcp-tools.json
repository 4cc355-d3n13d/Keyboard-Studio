  {
    "name": "orbit_configure",
    "description": "Change instrument, tempo, key, sound, effects, arpeggiator or favorite status. Partial updates preserve other settings. Instrument IDs are zero-based; root 0=C, 9=A; velocity is 0.1–1. Effect a/b follow the panel: reverb decay/mix, delay feedback/mix, distortion drive/mix, chorus/phaser/tremolo rate/mix, filter cutoff/Q, compressor threshold/ratio.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Session ID returned by orbit_list_sessions. Optional only when exactly one session is connected.",
          "minLength": 1,
          "maxLength": 80
        },
        "instrument_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 35
        },
        "bpm": {
          "type": "number",
          "minimum": 40,
          "maximum": 240
        },
        "root": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "scale": {
          "enum": [
            "minor",
            "major",
            "dorian",
            "pentatonic",
            "chromatic"
          ]
        },
        "scale_lock": {
          "type": "boolean"
        },
        "loop": {
          "type": "boolean"
        },
        "metronome": {
          "type": "boolean"
        },
        "humanize": {
          "type": "boolean"
        },
        "octave": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "velocity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "favorite": {
          "type": "boolean"
        },
        "sound": {
          "type": "object",
          "properties": {
            "attack": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 2
            },
            "decay": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 3
            },
            "sustain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "release": {
              "type": "number",
              "minimum": 0.03,
              "maximum": 5
            },
            "cutoff": {
              "type": "number",
              "minimum": 100,
              "maximum": 16000
            },
            "resonance": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 12
            },
            "volume": {
              "type": "number",
              "minimum": -30,
              "maximum": 0
            },
            "pan": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "fx": {
          "type": "object",
          "properties": {
            "reverb": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "boolean"
                },
                "a": {
                  "type": "number",
                  "minimum": 0.3,
                  "maximum": 6
                },
                "b": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.8
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "delay": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "boolean"
                },
                "a": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 0.75
                },
                "b": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.8
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "distortion": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "boolean"
                },
                "a": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.95
                },
                "b": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.8
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "chorus": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "boolean"
                },
                "a": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 8
                },
                "b": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "phaser": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "boolean"
                },
                "a": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 6
                },
                "b": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "filter": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "boolean"
                },
                "a": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 16000
                },
                "b": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 12
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "tremolo": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "boolean"
                },
                "a": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 14
                },
                "b": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "compressor": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "boolean"
                },
                "a": {
                  "type": "number",
                  "minimum": -45,
                  "maximum": 0
                },
                "b": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 12
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "arp": {
          "type": "object",
          "properties": {
            "on": {
              "type": "boolean"
            },
            "mode": {
              "enum": [
                "up",
                "down",
                "updown",
                "random",
                "played"
              ]
            },
            "rate": {
              "enum": [
                "4n",
                "8n",
                "16n",
                "32n"
              ]
            },
            "oct": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "gate": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 0.95
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "swing": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.65
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_transport",
    "description": "Play, pause, stop, start recording or stop recording. Sound and record_start require the user to click Start Audio in the web studio first.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Session ID returned by orbit_list_sessions. Optional only when exactly one session is connected.",
          "minLength": 1,
          "maxLength": 80
        },
        "action": {
          "enum": [
            "play",
            "pause",
            "stop",
            "record_start",
            "record_stop"
          ]
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_play_notes",
    "description": "Play a short chord or note in the selected instrument with automatic release. MIDI note 60=C4. Duration is in quarter-note beats, not seconds. Requires Start Audio. Respects the requested pitches unless respect_scale=true.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Session ID returned by orbit_list_sessions. Optional only when exactly one session is connected.",
          "minLength": 1,
          "maxLength": 80
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "minItems": 1,
          "maxItems": 12
        },
        "duration_beats": {
          "type": "number",
          "minimum": 0.0625,
          "maximum": 4
        },
        "velocity": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "respect_scale": {
          "type": "boolean"
        }
      },
      "required": [
        "notes"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_trigger_pad",
    "description": "Trigger one of 16 zero-based pads as a chord, drum, scale note or local sample. A sample must already be loaded in that browser. Loop/gate samples automatically stop after duration_beats. Requires Start Audio.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Session ID returned by orbit_list_sessions. Optional only when exactly one session is connected.",
          "minLength": 1,
          "maxLength": 80
        },
        "pad": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "mode": {
          "enum": [
            "chord",
            "drum",
            "scale",
            "sample"
          ]
        },
        "duration_beats": {
          "type": "number",
          "minimum": 0.0625,
          "maximum": 4
        },
        "velocity": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        }
      },
      "required": [
        "pad"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_set_pattern",
    "description": "Edit the 16/32-step sequencer. Each step is a sixteenth note. replace=true clears the current sequencer before applying the supplied rows; false patches only supplied steps/rows. A drum row lists all its active steps. Editing is undoable.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Session ID returned by orbit_list_sessions. Optional only when exactly one session is connected.",
          "minLength": 1,
          "maxLength": 80
        },
        "length": {
          "enum": [
            16,
            32
          ]
        },
        "replace": {
          "type": "boolean"
        },
        "melody": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "note": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "on": {
                "type": "boolean"
              },
              "velocity": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 1
              },
              "duration_steps": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 32
              }
            },
            "required": [
              "step",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "drums": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "drum": {
                "enum": [
                  "kick",
                  "snare",
                  "hat",
                  "clap"
                ]
              },
              "steps": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                }
              }
            },
            "required": [
              "drum",
              "steps"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_edit_notes",
    "description": "Add MIDI-like notes to the Piano Roll, or replace its full recording with replace=true. Times and durations are in sixteenth-note steps. Notes must fit within the current pattern length. Editing is undoable.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Session ID returned by orbit_list_sessions. Optional only when exactly one session is connected.",
          "minLength": 1,
          "maxLength": 80
        },
        "replace": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "properties": {
              "note": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "start_step": {
                "type": "number",
                "minimum": 0,
                "maximum": 31.99
              },
              "duration_steps": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 32
              },
              "velocity": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 1
              }
            },
            "required": [
              "note",
              "start_step",
              "duration_steps"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "notes"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_generate_progression",
    "description": "Create a complete melodic/drum pattern in the current key for a musical style. Replaces the sequencer; the edit is undoable.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Session ID returned by orbit_list_sessions. Optional only when exactly one session is connected.",
          "minLength": 1,
          "maxLength": 80
        },
        "genre": {
          "enum": [
            "House",
            "Techno",
            "Trance",
            "Ambient",
            "Synthwave",
            "Lo-fi"
          ]
        }
      },
      "required": [
        "genre"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_history",
    "description": "Undo or redo the last pattern/Piano Roll edit.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Session ID returned by orbit_list_sessions. Optional only when exactly one session is connected.",
          "minLength": 1,
          "maxLength": 80
        },
        "action": {
          "enum": [
            "undo",
            "redo"
          ]
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_export",
    "description": "Start a browser download of JSON, MIDI or WAV. JSON includes local sample audio. WAV renders one pattern cycle and effect tails in the browser, requires Start Audio, and stops transport. Returns download initiation, not a filesystem path.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Session ID returned by orbit_list_sessions. Optional only when exactly one session is connected.",
          "minLength": 1,
          "maxLength": 80
        },
        "format": {
          "enum": [
            "json",
            "midi",
            "wav"
          ]
        }
      },
      "required": [
        "format"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_load_project",
    "description": "Load a project JSON into a connected browser. Replaces the current session. Save/export first if needed. Maximum tool payload is 512 KB; larger projects can be opened with the studio file picker.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Session ID returned by orbit_list_sessions. Optional only when exactly one session is connected.",
          "minLength": 1,
          "maxLength": 80
        },
        "project": {
          "type": "object"
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_command_status",
    "description": "Read the completion or failure of an earlier queued command. Do not resend a timed-out command before checking this status.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "command_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
